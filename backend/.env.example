PORT=5000
MONGO_URI=mongodb://localhost:27017/studentstack
JWT_SECRET=your_jwt_secret_here

# Google OAuth Client ID (optional but recommended for verifying token audience)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# SMTP configuration for password reset emails (production-ready)
SMTP_HOST=your_smtp_host_here
SMTP_PORT=2525
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM="StudentStack" <noreply@studentstack.com>
FRONTEND_URL=http://localhost:5173
